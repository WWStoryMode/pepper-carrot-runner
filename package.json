{
  "name": "pepper-carrot-runner",
  "version": "0.0.0",
  "private": true,
  "description": "An endless runner set in the Pepper&Carrot universe, built with Phaser 4 + TypeScript.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "art": "tsx scripts/pack-atlas.ts",
    "predev": "npm run art",
    "dev": "vite",
    "prebuild": "npm run art",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "maxrects-packer": "^2.7.3",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
